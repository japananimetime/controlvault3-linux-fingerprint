#!/bin/bash
# cvlock — i3lock-color (blur or image) with fingerprint-to-unlock.
# Drop a screen-sized PNG at ~/.config/cvlock/lock.png to use an image instead of blur;
# set blur strength in ~/.config/cvlock/blur (default 10). Used by mod+l and xss-lock.
CFG="$HOME/.config/cvlock"; IMG="$CFG/lock.png"
BLUR="$(cat "$CFG/blur" 2>/dev/null || echo 10)"

if [ -f "$IMG" ]; then i3lock --nofork -i "$IMG" "$@" &
else                   i3lock --nofork --blur "$BLUR" "$@" & fi
LOCKPID=$!

# Fingerprint watcher: while locked, wait on the sensor and unlock on a match.
#
# This drives fprintd (the libfprint TOD driver), so fprintd is the ONLY owner of the sensor —
# the same thing pam_fprintd uses for sudo/ly/polkit. Do not mix this with the standalone
# pam_cvfp/cvfp-verify path: two owners fight over the device and wedge it.
#
# We match on the explicit result string, NOT the exit code: fprintd-verify can exit 0 on a
# no-match, so trusting $? here would unlock the screen for any finger.
# On unlock we SIGTERM the in-flight verify so the capture is cancelled and the device released.
(
  VPID=""
  trap 'kill -TERM "$VPID" 2>/dev/null; exit 0' TERM
  OUTF=$(mktemp); trap 'rm -f "$OUTF"' EXIT
  while kill -0 "$LOCKPID" 2>/dev/null; do
    : > "$OUTF"
    # run in background so $VPID is killable by the TERM trap above
    timeout 12 fprintd-verify "$USER" > "$OUTF" 2>&1 &
    VPID=$!; wait "$VPID"
    if grep -q "Verify result: verify-match" "$OUTF"; then
      kill "$LOCKPID" 2>/dev/null; break
    fi
  done
) &
WATCHPID=$!

wait "$LOCKPID"
kill -TERM "$WATCHPID" 2>/dev/null
exit 0
